###
### use this config with herdr
###

theme = light:Github,dark:Kitty Default

macos-option-as-alt = true
macos-titlebar-style = tabs
quit-after-last-window-closed = true
copy-on-select = false

# disable ligatures
font-feature = -calt

keybind = clear

keybind = cmd+shift+ctrl+option+p=toggle_command_palette

# delete word back (ESC DEL)
keybind = option+backspace=text:\x1b\x7f
# delete to start of line (ctrl+u), the default that `keybind = clear` removed
keybind = cmd+backspace=text:\x15

keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# search (ghostty defaults). performable: = only consume the key while a search is open,
# so escape still reaches zsh-vi-mode and cmd+g still reaches herdr's goto
keybind = cmd+f=start_search
keybind = cmd+e=search_selection
keybind = cmd+shift+f=end_search
keybind = performable:escape=end_search
keybind = performable:enter=navigate_search:next
keybind = performable:shift+enter=navigate_search:previous

keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

keybind = cmd+q=close_all_windows

# custom-shader = ./shaders/cursor_blaze.glsl
custom-shader = ./shaders/cursor_tail.glsl

command = /opt/homebrew/bin/herdr
